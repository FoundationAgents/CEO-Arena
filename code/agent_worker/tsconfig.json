        "../OpenCode/packages/llm/node_modules/effect/dist/unstable/*/index.js"
      ],
      "effect/*": ["../OpenCode/packages/llm/node_modules/effect/dist/*.js"]
    },
    "typeRoots": ["../OpenCode/packages/llm/node_modules/@types"],
    "types": ["bun"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts"]
}
