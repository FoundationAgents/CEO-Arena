{
  "extends": "../OpenCode/packages/llm/tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@opencode-ai/llm": ["../OpenCode/packages/llm/src/index.ts"],
      "@opencode-ai/llm/*": ["../OpenCode/packages/llm/src/*"],
      "@opencode-ai/schema": ["../OpenCode/packages/schema/src/index.ts"],
      "effect": ["../OpenCode/packages/llm/node_modules/effect/dist/index.js"],
